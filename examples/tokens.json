{
  "colors": {
    "text": {
      "primary": "#1f2937",
      "muted": "#4b5563",
      "inverse": "#ffffff"
    },
    "surface": {
      "default": "#ffffff",
      "subtle": "#f3f4f6"
    },
    "border": {
      "strong": "#6b7280"
    },
    "brand": {
      "primary": "#2563eb"
    },
    "status": {
      "$type": "color",
      "success": { "$value": "#15803d" },
      "warning": { "$value": "#b45309" },
      "danger": { "$value": "#b91c1c" }
    }
  },
  "pairs": [
    { "foreground": "text.primary", "background": "surface.default" },
    { "foreground": "text.muted", "background": "surface.subtle" },
    { "foreground": "brand.primary", "background": "surface.default" },
    { "foreground": "text.inverse", "background": "brand.primary" },
    { "foreground": "status.danger", "background": "surface.default" },
    { "foreground": "status.success", "background": "surface.subtle", "use": "large-text" },
    { "foreground": "border.strong", "background": "surface.default", "use": "non-text" }
  ]
}
