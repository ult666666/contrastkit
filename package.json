{
  "name": "contrastkit-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Accessible color, measured: WCAG 2.2 contrast checks, OKLCH fixes, color-vision-deficiency simulation and palette audits.",
  "license": "MIT",
  "author": "Charles Dai",
  "type": "module",
  "workspaces": [
    "packages/contrastkit"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
